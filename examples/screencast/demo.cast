3HContinuing.\u001b[K\u001b[25;83H^C\u001b[K\u001b[26;83HProgram received signal SIGINT, Interrupt.\u001b[K\u001b[33m\u001b[27;83Hget_char\u001b[39m () at \u001b[32mmain.c\u001b[39m:\u001b[2m177\u001b[m\u000f\u001b[K\u001b[2m\u001b[28;83H177\u001b[m\u000f             \u001b[34m\u001b[1mwhile\u001b[m\u000f \u001b[31m(\u001b[39mrx_tail \u001b[31m==\u001b[39m rx_head\u001b[31m)\u001b[39m\u001b[K\u001b[29;83H(gdb) delete\u001b[K\u001b[30;83H(gdb) monitor faults stop\u001b[K\u001b[31;83Hfaults stop\u001b[K\u001b[32;83H(gdb) continue\u001b[K\u001b[33;83HContinuing.\u001b[K\u001b[34;83H\u001b[K\nProgram received signal SIGBUS, Bus error.\u001b[K\u001b[36;83H\u001b[K\u001b[34h\u001b[?25h"]
