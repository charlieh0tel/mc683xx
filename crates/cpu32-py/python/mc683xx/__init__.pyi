@disjoint_base
class Event:
    """Something the chip did that the host may want to know of."""

    @final
    class Reset(Event):
        """The chip reset, at `now`, for `cause`."""

        __match_args__ = ("now", "cause")
        def __new__(cls, now: int, cause: ResetCause) -> Event.Reset: ...
        @property
        def now(self) -> int: ...
        @property
        def cause(self) -> ResetCause: ...

    @final
    class ArbitrationTie(Event):
        """Two interrupt sources of one level had the same nonzero IARB."""

        __match_args__ = ("level", "arbitration")
        def __new__(cls, level: int, arbitration: int) -> Event.ArbitrationTie: ...
        @property
        def level(self) -> int: ...
        @property
        def arbitration(self) -> int: ...

    @final
    class Access(Event):
        """A bus cycle that reached the chip, while accesses are traced."""

        __match_args__ = (
            "now",
            "address",
            "size",
            "function_code",
            "write",
            "value",
            "bus_error",
        )
        def __new__(
            cls,
            now: int,
            address: int,
            size: int,
            function_code: int,
            write: bool,
            value: int | None,
            bus_error: bool,
        ) -> Event.Access: ...
        @property
        def now(self) -> int: ...
        @property
        def address(self) -> int: ...
        @property
        def size(self) -> int: ...
        @property
        def function_code(self) -> int: ...
        @property
        def write(self) -> bool: ...
        @property
        def value(self) -> int | None: ...
        @property
        def bus_error(self) -> bool: ...

    @final
    class Exception(Event):
        """An exception entered, while exceptions are traced."""

        __match_args__ = ("now", "vector", "pc", "handler")
        def __new__(cls, now: int, vector: int, pc: int, handler: int) -> Event.Exception: ...
        @property
        def now(self) -> int: ...
        @property
        def vector(self) -> int: ...
        @property
        def pc(self) -> int: ...
        @property
        def handler(self) -> int: ...

    @final
    class Dsack(Event):
        """A peripheral's DSACK pins disagree with the chip at `now`."""

        __match_args__ = ("now", "fault")
        def __new__(cls, now: int, fault: DsackFault) -> Event.Dsack: ...
        @property
        def now(self) -> int: ...
        @property
        def fault(self) -> DsackFault: ...

@final
class Builder:
    """The board as the host wires it, before the power-on reset."""

    def __new__(
        cls,
        *,
        data: int = ...,
        reference_hz: int | None = None,
        external_hz: int | None = None,
    ) -> Builder: ...
    def memory(self, contents: bytes | bytearray, pins: Sequence[str], *, writable: bool = True) -> int: ...
    def fixed_memory(self, base: int, contents: bytes | bytearray, *, writable: bool = True) -> int: ...
    def fixed_timing(self, memory: int, *, port: int = 16, wait_states: int | None = None) -> None: ...
    def reload_scope(self, memory: int, scope: Sequence[ResetCause]) -> None: ...
    def peripheral(self, peripheral: _MappedPeripheral, pins: Sequence[str]) -> int: ...
    def bus_peripheral(
        self,
        peripheral: _MappedPeripheral,
        *,
        windows: Sequence[tuple[int, int]] = ...,
        acknowledges: Sequence[int] = ...,
        dsack: Dsack,
    ) -> int: ...
    def unwired_peripheral(self, peripheral: object) -> int: ...
    def qspi(self, peripheral: _SpiPeripheral) -> None: ...
    def dsack(self, peripheral: int, pins: Dsack) -> None: ...
    def qspi_reset_scope(self, scope: Sequence[ResetCause]) -> None: ...
    def stop_request(self) -> StopRequest: ...
    def sync_request(self) -> SyncRequest: ...
    def diversion(self) -> Diversion: ...
    def interrupt(self, peripheral: int, pin: int) -> None: ...
    def reset_scope(self, peripheral: int, scope: Sequence[ResetCause]) -> None: ...
    def autovector(self, pin: int) -> None: ...
    def build(self) -> Mc68331: ...

